# 复制本文件为 .env 后填入。.env 已在 .gitignore 中，不会进版本库。
# 切勿把真实 Key 贴进聊天、截图或提交记录。

# 生图 provider：gemini | seedream
SPRITE_PROVIDER=seedream

# --- Gemini（https://aistudio.google.com/apikey 领取）---
# ⚠ 图像模型免费层额度为 0（报错会显示 limit: 0），必须给项目开通付费层才能调用。
GEMINI_API_KEY=
# 模型：gemini-3.1-flash-image（性价比首选）/ gemini-3-pro-image（质量最高）
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 需要走代理或第三方中转时改这里，默认官方地址
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Seedream / 火山引擎方舟 ---
ARK_API_KEY=
# 留空即用代码默认值：差分用 doubao-seedream-5-0-pro-260628（零漂移，约 65s/张），
# 底图候选自动降级到 doubao-seedream-4-0-250828（约 5s/张，这步不需要一致性）。
# 填了这项则两个阶段都用它，失去自动换档。
ARK_IMAGE_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 全身立绘要竖构图。方形会逼模型把角色压扁或裁掉腿
ARK_IMAGE_SIZE=1440x2160

# ---------------------------------------------------------------------------
# 对话模型（统一走 OpenAI 兼容的 /chat/completions）
# ---------------------------------------------------------------------------
# 预设：ark | deepseek | dashscope | moonshot | openai | ollama
# 用其他厂商就留空这项，直接配 LLM_BASE_URL
LLM_PROVIDER=ark

# 模型 ID。方舟必填（版本号频繁变动，猜不准），到控制台复制：
#   https://console.volcengine.com/ark
# 也可填接入点 ID（ep-xxxxxxxx）
#
# 实测首字延迟（关闭深度思考后）：
#   doubao-seed-character-260628   2404ms  ← 角色扮演专用，人设质量最好，推荐
#   doubao-seed-2-0-lite-260428    3189ms
#   doubao-seed-2-1-turbo-260628   3664ms
LLM_MODEL=doubao-seed-character-260628

# 深度思考：disabled（默认）| enabled | auto
# ⚠ 千万别为了「回答质量」开它。实测开思考后首字延迟从 3 秒涨到 26~31 秒 ——
#   她要先写几百字思维链才开口，桌宠场景里这等于产品报废。
LLM_THINKING=disabled

# 下面三项都是「覆盖预设」用的，一般留空
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# 语音合成（可选）
# ---------------------------------------------------------------------------
# 不配就是纯文字，其余功能不受影响 —— 口型会退回按打字节奏的近似。
#
# 走 OpenAI 兼容的 POST /audio/speech。
# ⚠ 方舟（豆包）**没有**这个端点，它的语音合成是独立服务、另一套凭证，
#   所以这里不能复用 ARK_API_KEY。
TTS_ENABLED=0
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# mp3 而不是 wav：一句话的 wav 有几百 KB，要经 IPC 传到渲染层，大包会卡住主进程
TTS_FORMAT=mp3
# 陪伴场景略慢一点更自然，太快像播报
TTS_SPEED=0.95

# ---------------------------------------------------------------------------
# 看屏幕（可选，默认关闭）
# ---------------------------------------------------------------------------
# ⚠ 这是全项目**唯一会把屏幕内容送上云**的功能。
#   其余所有感知只送「进程名归类」这么一个词；开了这项，送的是整张截图。
#   截图里可能有明文密码、私信、银行页面、公司文档 —— 想清楚再开。
#
# 已经做的约束：
#   · 只截**前台那一个窗口**，不截整个桌面（匹配不到窗口宁可不看）
#   · 截图绝不落盘，用完即弃，不进缓存/日记/记忆
#   · 缩到 768px 宽再传
#   · 自动监听前台 Steam 和游戏窗口；不用手动维护活动白名单
#   · 静止的 Steam 页面也会低频瞥一眼，捕获显示出来的游戏时长
#   · 只截前台窗口；每次截图至少间隔 90 秒，且吃同一份主动打扰预算
#   · 截图绝不落盘，只有经过结构化脱敏的文字线索会交给角色
VISION_ENABLED=0

# 留空则复用对话配置，但前提是对话接口本身接受 OpenAI image_url 消息块。
# 若对话端点只接受文本，请为视觉功能配置另一套多模态接口。
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# 资源管理器的截图常带路径、文档名和下载记录，隐私风险远高于“发现小游戏”的收益，
# 所以默认关。若明确接受这个取舍，设为 1；它仍只在窗口切换时识别，且不会保留文件名。
VISION_FOLDER_ENABLED=0

# 1：疑似全屏时静默（默认，避免直播/录屏把桌宠声音带进去）。
# 0：允许她在全屏或无边框窗口化游戏时也识屏、开口；请确认这符合你的直播/录屏习惯。
AWARENESS_FULLSCREEN_SILENT=1

# --- 通用 ---
# 全局 HTTP(S) 代理，例如 http://127.0.0.1:7890
HTTPS_PROXY=
# 单次请求超时（毫秒）。5.0 Pro 慢，默认 300000 已留足余量
SPRITE_TIMEOUT_MS=
