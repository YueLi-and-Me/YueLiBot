{
  "manifest_version": 1,
  "id": "yueli.napcat-adapter",
  "plugin_type": "adapter",
  "name": "YueLi-NapCat-Adapter",
  "version": "0.1.0",
  "description": "连接 NapCat 协议端的 OneBot 11 适配器；戳一戳依赖其私有 packet 后端，连接后实测",
  "protocol": "onebot11",
  "config_section": "napcat",
  "capabilities": {
    "static": [
      "send_message",
      "quote_reply",
      "reaction",
      "forward_message",
      "group_history",
      "member_info"
    ],
    "probed": [
      "poke"
    ]
  }
}
