{
  "name": "yueli-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 桌面陪伴 —— Live2D / AI 立绘差分桌宠",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build && vite build --config webui/vite.config.ts",
    "dev:webui": "vite --config webui/vite.config.ts",
    "selftest": "electron . --selftest",
    "sprite:test": "tsx scripts/sprite/test.ts",
    "sprite:diagnose": "tsx scripts/sprite/diagnose.ts",
    "sprite:base": "tsx scripts/sprite/base.ts",
    "sprite:gen": "tsx scripts/sprite/gen.ts",
    "sprite:preview": "tsx scripts/sprite/preview.ts",
    "sprite:process": "tsx scripts/sprite/process.ts",
    "sprite:fixture": "tsx scripts/sprite/fixture.ts",
    "sprite:process:fixture": "tsx scripts/sprite/process.ts --naive --name fixture",
    "sprite:preview:fixture": "tsx scripts/sprite/preview.ts --name fixture",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx tests/integration/backend_client.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "active-win": "^8.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sharp": "^0.34.4",
    "smol-toml": "^1.7.1",
    "tailwind-merge": "^3.6.0",
    "uiohook-napi": "^1.5.5",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
