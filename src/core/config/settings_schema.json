{
  "version": 1,
  "files": [
    {
      "file": "bot.toml",
      "label": "Bot 与人格",
      "description": "Bot 身份、群聊回复策略、日程、人格与对话记忆参数。",
      "sections": [
        {
          "kind": "object",
          "key": "bot",
          "label": "身份与关系",
          "description": "Bot 的显示名、别名和对用户的称呼。",
          "fields": [
            {
              "key": "name",
              "type": "string",
              "label": "Bot 名字",
              "required": true,
              "help": "Bot 的显示名，也会作为系统提示词中的身份名；不能为空，也不能与别名重复。"
            },
            {
              "key": "aliases",
              "type": "string_list",
              "label": "群聊别名",
              "help": "群聊里也会回应的其它称呼，每行一个；不能为空、重复或等于 Bot 名字。"
            },
            {
              "key": "user_nickname",
              "type": "string",
              "label": "对你的称呼",
              "help": "Bot 对用户的称呼偏好；留空表示不主动使用特定称呼。"
            },
            {
              "key": "relationship",
              "type": "string",
              "label": "和你的关系",
              "help": "Bot 和用户的关系，例如“哥哥”“姐姐”“朋友”；留空则不预设关系。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "group_chat",
          "label": "群聊策略",
          "description": "群聊中 @、名字触发和回复频率的控制参数。",
          "fields": [
            {
              "key": "at_mention_must_reply",
              "type": "boolean",
              "label": "@ 提及必回",
              "help": "开启时协议 @ 提及不受睡眠与群聊回复窗口限制。"
            },
            {
              "key": "name_mention_probability",
              "type": "number",
              "label": "名字触发回复概率",
              "min": 0,
              "max": 1,
              "step": 0.05,
              "help": "名字、别名或非必回 @ 命中后的回复概率，范围 0~1。"
            },
            {
              "key": "presence_decay_strength",
              "type": "number",
              "label": "存在感衰减强度",
              "min": 0,
              "max": 20,
              "step": 0.25,
              "help": "数值越大，Bot 在群里说得越多时越倾向于让别人先说；范围 0~20。"
            },
            {
              "key": "persona_weight",
              "type": "number",
              "label": "人格增量折算系数",
              "min": 0,
              "max": 1,
              "step": 0.05,
              "help": "群聊里人格增量的折算系数；一句一答的消耗远小于面对面长聊。"
            },
            {
              "key": "reply_window_minutes",
              "type": "integer",
              "label": "回复统计窗口（分钟）",
              "min": 1,
              "help": "在这段时间窗口内统计 Bot 已经回复了多少次。"
            },
            {
              "key": "max_replies_in_window",
              "type": "integer",
              "label": "窗口内最大回复次数",
              "min": 0,
              "help": "非必回消息在时间窗口内允许的最大回复次数；0 表示不限制。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "schedule",
          "label": "日程与作息",
          "description": "每日日程段数、自动睡眠和生成失败时的备用文本。",
          "fields": [
            {
              "key": "min_slots",
              "type": "integer",
              "label": "最少日程段数",
              "min": 1,
              "max": 24,
              "help": "每天生成的日程段数下限。"
            },
            {
              "key": "max_slots",
              "type": "integer",
              "label": "最多日程段数",
              "min": 1,
              "max": 24,
              "help": "每天生成的日程段数上限；不能小于最少段数。"
            },
            {
              "key": "sleep_enabled",
              "type": "boolean",
              "label": "自动睡眠",
              "help": "是否启用自动睡眠状态；关闭后 bedtime/wake 仅保留为结构字段。"
            },
            {
              "key": "fallback_bedtime",
              "type": "time",
              "label": "备用入睡时间",
              "help": "模型不可用或输出不合法时使用的入睡时间，格式 HH:MM。"
            },
            {
              "key": "fallback_wake",
              "type": "time",
              "label": "备用醒来时间",
              "help": "模型不可用或输出不合法时使用的醒来时间，格式 HH:MM。"
            },
            {
              "key": "bedtime_day_boundary",
              "type": "time",
              "label": "跨日分界",
              "help": "小于等于此时间的 bedtime 视为计划日结束后的次日时间。"
            },
            {
              "key": "fallback_activity",
              "type": "string",
              "label": "备用活动",
              "maxLength": 72,
              "help": "日程生成失败时使用的活动文本，1~72 字符。"
            },
            {
              "key": "fallback_mood",
              "type": "string",
              "label": "备用状态",
              "maxLength": 40,
              "help": "日程生成失败时使用的状态文本，1~40 字符。"
            },
            {
              "key": "fallback_theme",
              "type": "string",
              "label": "备用日主题",
              "maxLength": 72,
              "help": "日程生成失败时使用的当日主题，1~72 字符。"
            },
            {
              "key": "fallback_carry_over",
              "type": "string",
              "label": "备用承接事项",
              "maxLength": 72,
              "help": "日程生成失败时使用的明日承接事项，1~72 字符。"
            },
            {
              "key": "generation_retry_interval_minutes",
              "type": "integer",
              "label": "生成失败重试间隔（分钟）",
              "min": 1,
              "max": 1440,
              "help": "日程生成失败后再次尝试前等待的分钟数。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "personality",
          "label": "人设与说话方式",
          "description": "Bot 的稳定人设、生日、回复风格和表达习惯候选。",
          "fields": [
            {
              "key": "birthday",
              "type": "date",
              "label": "生日",
              "help": "格式 YYYY-MM-DD；留空时不派生年龄与生日提示，也不能晚于今天。"
            },
            {
              "key": "personality",
              "type": "textarea",
              "label": "人设",
              "help": "稳定身份、经历、外表与性格；只从这份配置进入提示词。"
            },
            {
              "key": "reply_style",
              "type": "textarea",
              "label": "说话方式",
              "help": "句长、语气、排版和收尾习惯。"
            },
            {
              "key": "tone_probability",
              "type": "number",
              "label": "临时说话方式概率",
              "min": 0,
              "max": 1,
              "step": 0.05,
              "help": "新会话抽取临时语调的概率；0 表示始终不抽取。"
            },
            {
              "key": "tone_variants",
              "type": "string_list",
              "label": "临时说话方式候选",
              "help": "候选的会话级语调，每行一条，只在新会话开始时至多抽取一条。"
            },
            {
              "key": "expression_habits",
              "type": "string_list",
              "label": "回复表达习惯",
              "help": "回复时可供表达选择模型挑选的具体说话习惯；每条同时写清情境和接法。"
            },
            {
              "key": "proactive_expression_habits",
              "type": "string_list",
              "label": "主动搭话表达习惯",
              "help": "Bot 主动开口时可随机采用的具体说话习惯，每行一条。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "conversation",
          "label": "对话与记忆",
          "description": "工作记忆窗口、摘要节奏和记忆召回数量。",
          "fields": [
            {
              "key": "working_memory_messages",
              "type": "integer",
              "label": "工作记忆消息数",
              "min": 8,
              "max": 200,
              "help": "每轮送进模型的最近消息条数，不含系统提示词。"
            },
            {
              "key": "summarize_trigger_messages",
              "type": "integer",
              "label": "摘要触发消息数",
              "min": 12,
              "max": 500,
              "help": "未摘要消息达到此数量后触发一次长期记忆摘要。"
            },
            {
              "key": "summarize_batch_messages",
              "type": "integer",
              "label": "单次摘要消息数",
              "min": 4,
              "max": 200,
              "help": "每次摘要消化的最老消息条数；必须小于触发数量。"
            },
            {
              "key": "session_gap_minutes",
              "type": "integer",
              "label": "会话间隔（分钟）",
              "min": 1,
              "max": 1440,
              "help": "超过此空闲时长视为新会话，并重新抽取临时语调。"
            },
            {
              "key": "fact_recall_limit",
              "type": "integer",
              "label": "事实召回上限",
              "min": 0,
              "max": 50,
              "help": "每轮最多召回的事实记忆数量；0 表示不召回事实。"
            },
            {
              "key": "recalled_episode_limit",
              "type": "integer",
              "label": "相关情节召回数",
              "min": 0,
              "max": 20,
              "help": "按当前输入相关性召回的情节数量。"
            },
            {
              "key": "recent_episode_limit",
              "type": "integer",
              "label": "最近情节补充数",
              "min": 0,
              "max": 20,
              "help": "无论相关性如何都补充的最近情节数量。"
            },
            {
              "key": "episode_context_limit",
              "type": "integer",
              "label": "情节上下文上限",
              "min": 0,
              "max": 30,
              "help": "去重后最终写入系统提示词的情节总上限。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "conversation_agent",
          "label": "Conversation 行动核心",
          "description": "多智能体行动核心的灰度开关、触发口径与测试流清单。",
          "fields": [
            {
              "key": "mode",
              "type": "enum",
              "label": "运行模式",
              "options": [
                {
                  "value": "off",
                  "label": "关闭（旧管线）"
                },
                {
                  "value": "shadow",
                  "label": "影子记录（不改行为）"
                },
                {
                  "value": "selected_streams",
                  "label": "仅指定会话"
                },
                {
                  "value": "enabled",
                  "label": "全部启用"
                }
              ],
              "help": "off 保留旧管线；shadow 只记录决策；selected_streams 只对清单内会话生效；enabled 对全部真实候选生效。"
            },
            {
              "key": "selected_streams",
              "type": "string_list",
              "label": "指定会话 ID",
              "help": "mode=selected_streams 时生效的 stream ID 清单，每行一个。"
            },
            {
              "key": "split_replyer",
              "type": "boolean",
              "label": "决策与表达分开调用",
              "help": "打开后发言要跑两次模型：先定动作，再写正文，首字延迟明显上升。想压延迟就在模型配置里给「行动决策」单独指一个快模型。沉默、等待、贴表情、戳一戳不受影响。"
            },
            {
              "key": "tool_calling",
              "type": "boolean",
              "label": "使用工具调用选择动作",
              "help": "默认开启，且依赖决策与表达分开调用。行动决策模型必须支持工具调用；开启时同时使用扁平 item 上下文，关闭后改用旧 XML 动作协议。"
            },
            {
              "key": "trigger_mode",
              "type": "enum",
              "label": "普通群消息触发口径",
              "options": [
                {
                  "value": "signal",
                  "label": "信号（signal）"
                },
                {
                  "value": "frequency",
                  "label": "发言频率（frequency）"
                },
                {
                  "value": "reply_necessity",
                  "label": "回复必要性（reply_necessity）"
                }
              ],
              "help": "signal 沿用原口径；frequency 按发言频率给候选；reply_necessity 按回复必要性评分。"
            },
            {
              "key": "frequency_talk_value",
              "type": "number",
              "label": "频率尺度",
              "min": 0.01,
              "max": 1,
              "step": 0.05,
              "help": "frequency 模式的消息条数尺度，必须大于 0 且不超过 1。"
            },
            {
              "key": "reply_necessity_threshold",
              "type": "integer",
              "label": "回复必要性阈值",
              "min": 0,
              "max": 100,
              "help": "reply_necessity 模式的评分阈值，0~100。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "typing",
          "label": "打字节奏",
          "description": "一段话切成几条气泡、每条之间隔多久。",
          "fields": [
            {
              "key": "bubble_target_chars",
              "type": "number",
              "label": "单条气泡目标字数",
              "help": "先按标点切成最小片段，再合并到接近该长度为止；必须大于 0。"
            },
            {
              "key": "max_bubbles_per_say",
              "type": "number",
              "label": "一条台词最多气泡数",
              "help": "话越长每条也越长，条数不随长度无限增长；至少为 1。"
            },
            {
              "key": "delay_enabled",
              "type": "boolean",
              "label": "模拟打字停顿",
              "help": "关闭后多条气泡会连续发出。"
            },
            {
              "key": "chinese_char_seconds",
              "type": "number",
              "label": "中文打字速度（秒/字）",
              "help": "中文按整字输入计价。"
            },
            {
              "key": "latin_char_seconds",
              "type": "number",
              "label": "拉丁字符速度（秒/字）",
              "help": "字母与数字连打明显快于中文。"
            },
            {
              "key": "send_gap_seconds",
              "type": "number",
              "label": "发送间隙（秒）",
              "help": "打完到按下回车之间的固定停顿。"
            },
            {
              "key": "max_delay_seconds",
              "type": "number",
              "label": "单条等待上限（秒）",
              "help": "长内容按字数线性算会让对方干等，超过上限即截断。"
            },
            {
              "key": "emoji_pick_seconds",
              "type": "number",
              "label": "挑表情包耗时（秒）",
              "help": "表情包不逐字打，不走字数公式。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "typing.follow_up",
          "label": "静默主动追问",
          "description": "Bot 正常回复后对方一直没回，达到阈值时先做独立情景分析，再让行动核心结合历史选择 reply 或 silent；只在 Conversation Agent 已启用或被 selected_streams 选中的私聊生效。",
          "fields": [
            {
              "key": "enabled",
              "type": "boolean",
              "label": "启用主动追问",
              "help": "关闭后不创建一分钟静默决策任务，输入状态决策仍可独立工作。"
            },
            {
              "key": "peer_silence_minutes",
              "type": "number",
              "label": "主动追问阈值（分钟）",
              "help": "Bot 正常回复后对方持续不回复这么久，创建一次 reply / silent 决策机会；必须大于 0。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "typing.nudge",
          "label": "久等后的催促",
          "description": "从 Bot 正常回复起达到总静默阈值，看到对方开始打字时让行动核心决定是否再追问；只在私聊生效。",
          "fields": [
            {
              "key": "enabled",
              "type": "boolean",
              "label": "启用催促",
              "help": "关闭后输入状态通知只被记录后丢弃。"
            },
            {
              "key": "peer_silence_minutes",
              "type": "number",
              "label": "输入检测总阈值（分钟）",
              "help": "从 Bot 正常回复起累计静默这么久才允许输入状态触发追问；中间的定时追问不重新计时。"
            },
            {
              "key": "max_per_silence",
              "type": "number",
              "label": "同一段静默最多追问次数",
              "help": "只统计行动核心实际选择 reply 并成功投递的次数；选择 silent 不消耗次数。默认上限为 2。"
            }
          ]
        }
      ]
    },
    {
      "file": "features.toml",
      "label": "功能开关",
      "description": "语音合成、屏幕视觉、感知出口、向量召回、日志与代理等运行参数。",
      "sections": [
        {
          "kind": "object",
          "key": "tts",
          "label": "语音合成",
          "description": "TTS 功能开关与音色；服务地址和密钥在 providers.toml 中维护。",
          "fields": [
            {
              "key": "enabled",
              "type": "boolean",
              "label": "启用语音合成",
              "help": "关闭时保持纯文字回复。"
            },
            {
              "key": "voice",
              "type": "string",
              "label": "音色 ID",
              "help": "厂商提供的音色 ID；不是显示名称。豆包语音这里填 voice_type。"
            },
            {
              "key": "format",
              "type": "enum",
              "label": "音频格式",
              "options": [
                {
                  "value": "mp3",
                  "label": "mp3"
                },
                {
                  "value": "wav",
                  "label": "wav"
                },
                {
                  "value": "opus",
                  "label": "opus"
                }
              ],
              "help": "返回音频格式：mp3 / wav / opus。"
            },
            {
              "key": "speed",
              "type": "number",
              "label": "语速倍率",
              "min": 0.25,
              "max": 4,
              "step": 0.05,
              "help": "语速倍率；陪伴场景建议略低于 1。"
            },
            {
              "key": "cluster",
              "type": "string",
              "label": "豆包语音集群",
              "help": "仅 client_type=volcengine 时生效：豆包语音的集群名。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "vision",
          "label": "屏幕视觉",
          "description": "屏幕截图与视觉模型的隐私控制。",
          "fields": [
            {
              "key": "enabled",
              "type": "boolean",
              "label": "启用屏幕视觉",
              "help": "用户询问屏幕内容时截取一帧发送给视觉模型；未询问时不截取。默认关闭。"
            },
            {
              "key": "chat_image_enabled",
              "type": "boolean",
              "label": "启用聊天图片描述",
              "help": "是否允许 QQ 聊天图片调用视觉模型描述；与桌面屏幕视觉独立开关。"
            },
            {
              "key": "fullscreen_silent",
              "type": "boolean",
              "label": "全屏时静默",
              "help": "检测到疑似全屏窗口时是否保持静默，避免直播或录屏意外播报。"
            },
            {
              "key": "capture_mode",
              "type": "enum",
              "label": "截图范围",
              "options": [
                {
                  "value": "window",
                  "label": "仅前台窗口（window）"
                },
                {
                  "value": "screen",
                  "label": "整个主屏（screen）"
                }
              ],
              "help": "window 只截前台那一个窗口；screen 截整个主屏，可能包含其他窗口和隐私内容。"
            }
          ]
        },
        {
          "kind": "object",
          "key": "perception",
          "label": "屏幕情境出口",
          "description": "允许 Bot 在哪些会话出口提及前台程序和屏幕内容。",
          "fields": [
            {
              "key": "surfaces",
              "type": "multi_enum",
              "label": "允许提及的出口",
              "options": [
                {
                  "value": "desktop",
                  "label": "桌宠窗口"
                },
                {
                  "value": "direct",
                  "label": "QQ 私聊"
                }
              ],
